<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: serve the emulator's binary files (IIS answers 404 for unknown extensions) -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".wasm" /><mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".rom" /><mimeMap fileExtension=".rom" mimeType="application/octet-stream" />
      <remove fileExtension=".hdd" /><mimeMap fileExtension=".hdd" mimeType="application/octet-stream" />
      <remove fileExtension=".ini" /><mimeMap fileExtension=".ini" mimeType="text/plain" />
      <remove fileExtension=".$b" /><mimeMap fileExtension=".$b" mimeType="application/octet-stream" />
      <remove fileExtension=".trd" /><mimeMap fileExtension=".trd" mimeType="application/octet-stream" />
      <remove fileExtension=".scl" /><mimeMap fileExtension=".scl" mimeType="application/octet-stream" />
      <remove fileExtension=".fdi" /><mimeMap fileExtension=".fdi" mimeType="application/octet-stream" />
      <remove fileExtension=".tap" /><mimeMap fileExtension=".tap" mimeType="application/octet-stream" />
      <remove fileExtension=".tzx" /><mimeMap fileExtension=".tzx" mimeType="application/octet-stream" />
    </staticContent>
    <security><requestFiltering><fileExtensions>
      <remove fileExtension=".ini" /><add fileExtension=".ini" allowed="true" />
    </fileExtensions></requestFiltering></security>
  </system.webServer>
</configuration>
